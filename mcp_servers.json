{
  "servers": {
    "filesystem": {
      "enabled": true,
      "command": [
        "{node}",
        "{filesystem_server}",
        "{workspace}"
      ]
    },
    "git": {
      "enabled": true,
      "command": [
        "{python}",
        "-m",
        "mcp_server_git",
        "--repository",
        "{workspace}"
      ]
    },
    "network_ops": {
      "enabled": true,
      "command": [
        "{python}",
        "-m",
        "src.network_server"
      ]
    },
    "network_ops_remote": {
      "enabled": false,
      "transport": "streamable_http",
      "url_env": "MCP_REMOTE_URL",
      "auth_token_env": "MCP_REMOTE_TOKEN"
    }
  }
}
